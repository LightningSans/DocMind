# DocMind 环境变量配置
# 复制此文件为 .env 并填写实际值

# ---------- API 鉴权 ----------
# 用于访问 API 的密钥，请修改为随机字符串
DOCMIND_API_KEY=yueyun

# ---------- Qdrant 向量数据库 ----------
# 如果 Qdrant 运行在 Docker，默认地址为 http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
# 也可直接设置完整 URL（优先级更高）
# QDRANT_URL=http://localhost:6333

# ---------- Embedding 模型 (OpenAI 兼容) ----------
# 可使用 OpenAI 或任意兼容的 Embedding API
EMBEDDING_API_KEY={ALIYUN_API_KEY}
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 如果使用 BGE 等本地模型，调整维度：
EMBEDDING_DIMENSION=1024

# ---------- DeepSeek LLM ----------
LLM_API_KEY={DEEPSEEK_API_KEY}
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ---------- 文档分块 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---------- RAG 检索 ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.6

# ---------- 上传限制 ----------
MAX_UPLOAD_SIZE_MB=20
